{
  "schemaVersion": 1,
  "hubType": "vnet",
  "repository": {
    "provider": "AzureRepos",
    "organization": "example-org",
    "project": "example-project",
    "name": "hub-network",
    "targetBranch": "main"
  },
  "branchNameTemplate": "concierge/spoke-[#_service.environment_#]-[#_service.name_#]",
  "files": [
    {
      "source": "ipam-spoke.yaml",
      "target": "ipam/spokes/[#_service.environment_#]-[#_service.name_#].yaml",
      "mode": "addOnly"
    }
  ],
  "completion": { "strategy": "autoComplete", "mergeStrategy": "squash", "deleteSourceBranch": true }
}
